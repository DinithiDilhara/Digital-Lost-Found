# Copy to .env at the repository root. Use your local MySQL account.
# Values are literal text (no quotes or PowerShell expressions).
DB_URL=jdbc:mysql://127.0.0.1:3306/digital_lost_found?connectTimeout=5000&socketTimeout=10000
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
# Optional: JAVA_HOME=C:\path\to\jdk-17
# Optional: PORT=5000 (also set VITE_API_TARGET if changing it)
# Optional: WS_PORT=5001 (also set VITE_WS_PORT if changing it)
# Optional: HOST=127.0.0.1 (use 0.0.0.0 for trusted-LAN access)
# Optional: VITE_HOST=0.0.0.0 to allow other devices on your trusted LAN
