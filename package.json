{
  "name": "digital-lost-found",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "predev": "node frontend/scripts/sync-assets.mjs",
    "dev": "concurrently --kill-others-on-fail --names backend,frontend --prefix-colors blue,green \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\Start-Dev-Backend.ps1",
    "dev:frontend": "node frontend/scripts/wait-for-backend.mjs && vite --config frontend/vite.config.mjs --host 0.0.0.0",
    "prebuild": "node frontend/scripts/sync-assets.mjs",
    "build": "vite build --config frontend/vite.config.mjs",
    "preview": "vite preview --config frontend/vite.config.mjs",
    "test": "node --test frontend/tests/api.test.mjs frontend/tests/parity.mjs frontend/tests/socket.test.mjs",
    "test:integration": "node tests/integration.mjs"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.7",
    "vite": "^8.3.4"
  }
}
